{
  "name": "ithyno-electron",
  "version": "0.8.1-alpha.1",
  "private": true,
  "description": "Electron desktop shell for ithyno",
  "author": "ithyno contributors",
  "license": "GPL-3.0-or-later",
  "main": "out/main.js",
  "scripts": {
    "build": "node ../scripts/check-preload-imports.mjs && node ../scripts/sync-about-config.mjs && tsc -p tsconfig.json",
    "dev": "node ../scripts/check-preload-imports.mjs && node ../scripts/sync-about-config.mjs && tsc -p tsconfig.json && node ../scripts/launch-electron.mjs",
    "prepack:host": "node scripts/prepack.mjs",
    "package:mac": "npm run prepack:host && electron-builder --mac",
    "package:win": "npm run prepack:host && electron-builder --win",
    "package:linux": "npm run prepack:host && electron-builder --linux",
    "package:all": "npm run prepack:host && electron-builder --mac --win --linux"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "open": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.19.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.18.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "dev.ithyno.app",
    "productName": "ithyno",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "welcome.html",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "host",
        "to": "app"
      }
    ],
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-installer.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    }
  }
}
