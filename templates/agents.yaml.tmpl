# ithyno agent registry — generated by `ithyno init`.
# Edit to add workers, change the Manager command, etc.
# See templates/agents.yaml.example for the full schema reference.

agents:
  - name: manager
    roles: [manager]
    mode: live-shell
    command: {{MANAGER_COMMAND}}
    # args intentionally empty: runtime chooses per-CLI startup args
    # (session-id mint / resume for Claude; plain command for other CLIs).
    # Override here with an explicit list to bypass the smart resolver.
    # Dispatch uses the Manager's native delegation path when available:
    # - Claude Manager -> Task/Agent tool
    # - Agy/Antigravity Manager -> invoke_subagent for same-CLI workers
    # - Codex Manager or any cross-CLI worker -> AgentRunner fallback
    args: []
