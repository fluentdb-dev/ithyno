# SPDX-License-Identifier: MIT
# OpenSpec UI agent registry.
#
# Copy this file to `agents.yaml` at the project root and edit. The dashboard
# loads it on startup and again whenever the file changes. With no agents
# defined (or no `agents.yaml`), the Kanban Run button is hidden.
#
# Template variables available in `args` and `env`:
#   ${change_id}     — the OpenSpec change id (e.g. "add-task-filter")
#   ${worktree_path} — absolute path to the agent's git worktree
#   ${branch}        — the agent branch ("agent/<change-id>")
#
# Spawning is `child_process.spawn(command, args, { cwd: worktree_path, env })`.
# The agent inherits the project's working tree via the worktree; it should
# end by leaving its changes committed (or at least staged) on the branch.
#
# Top-level `worktreePool` block (all keys optional, defaults shown):
#   worktreePool:
#     max: 5                   # hard cap on .worktrees/pool-N/; integer >= 1
#     namePrefix: pool         # -> .worktrees/pool-1/, pool-2/, ...
#     cleanupBetweenJobs: git-clean   # Phase 1 accepts only this
#
# The pool block tunes the pool but does NOT activate it. Agents opt in
# individually via `dedicated: false` on the agent entry. With no agent
# opted in, the pool block is inert and behavior is identical to the
# pre-pool per-change worktree flow. Landed by add-worktree-pool.

# --- Optional: declare a `manager` agent ---------------------------------
# The embedded Terminal panel spawns whatever the `manager` agent
# declares (its `command` + `args`). Without a manager entry, ithyno
# opens a fresh `claude` session — safe for both new and existing
# projects; from inside Claude Code you can `/resume` to pick a
# specific prior conversation when you want one.
#
# `--continue` is intentionally NOT documented here: it auto-picks
# "some prior session" opaquely, and fails outright with "No
# conversation found to continue" on a freshly-scaffolded project.
# Prefer explicit `--resume <id>` when you want to pin to a specific
# session; otherwise let the default fresh `claude` handle it.
#
# Uncomment ONE of the samples below to override the default:
#
# agents:
#   - name: manager
#     mode: live-shell
#     roles: [manager]
#     command: claude                        # explicit fresh session (same as default)
#
#   - name: manager
#     mode: live-shell
#     roles: [manager]
#     command: claude
#     args: [--resume, <session-id>]         # pin to a specific past session

# --- Worker agents -------------------------------------------------------
agents:
  - name: claude
    description: Implements the change using Claude Code via /opsx:apply.
    command: claude
    args: ["/opsx:apply", "${change_id}"]

    # Optional metadata fields — Phase 1 of the multi-agent redesign records
    # them but the runner does not consume them yet. Later phases wire them
    # into a dispatcher that routes jobs by role + specialty and honors
    # per-agent concurrency caps. Safe to omit; defaults shown below.
    #
    # role: coder          # coder | reviewer | proposer | ... (open set)
    # specialties: []      # tag prefixes claimed as expertise; empty = any
    # concurrency: 1       # integer >= 1; declared capacity, NOT enforced yet

    # dedicated: true      # (default) each job gets .worktrees/<change-id>/;
                           # set to false to lease from the pool below instead.
                           # Uncommitted work in a pool worktree is DISCARDED
                           # at release — the bundled apply skill commits
                           # before stopping so this only bites misbehaving
                           # agents. Landed by add-worktree-pool.

  # Add more agents as you need them — any local CLI works.
  # - name: aider
  #   description: Implements with Aider.
  #   command: aider
  #   args: ["--yes", "--message", "Implement openspec change ${change_id}"]
  #   env:
  #     OPENAI_API_KEY: "..."
