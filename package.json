{
  "name": "ithyno",
  "version": "0.8.1-alpha.0",
  "description": "Local dashboard for OpenSpec — dispatches propose / apply / review / verify skills to AI CLI agents.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluentdb-dev/ithyno"
  },
  "bugs": {
    "url": "https://github.com/fluentdb-dev/ithyno/issues"
  },
  "type": "module",
  "bin": {
    "ithyno": "bin/ithyno.js"
  },
  "files": [
    "bin",
    "ithyno/skills",
    "server",
    "templates",
    "web/dist",
    "tsconfig.json"
  ],
  "workspaces": [
    "electron",
    "vscode-extension"
  ],
  "overrides": {
    "js-yaml": "4.3.1",
    "gray-matter": {
      "js-yaml": "3.15.1"
    }
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "OPENSPEC_DEV=1 tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:test": "concurrently -n api,web -c blue,magenta \"OPENSPEC_DEV=1 tsx server/index.ts\" \"npm:dev:web\"",
    "build": "vite build",
    "build:server": "tsc -p server-dist.tsconfig.json",
    "start": "node bin/ithyno.js",
    "demo": "node bin/ithyno.js --dir examples/sample-project",
    "openspec": "openspec",
    "clean:worktrees": "bin/clean-worktrees.sh",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npm run --workspace ithyno-electron dev",
    "electron:package": "npm run --workspace ithyno-electron package:mac",
    "electron:package:mac": "npm run --workspace ithyno-electron package:mac",
    "electron:package:win": "npm run --workspace ithyno-electron package:win",
    "electron:package:linux": "npm run --workspace ithyno-electron package:linux",
    "electron:package:all": "npm run --workspace ithyno-electron package:all",
    "build:icons": "node scripts/build-icons.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:verify-bundle": "node scripts/verify-bundle.mjs",
    "release:version": "node scripts/release-version.mjs",
    "e2e:skills": "E2E=1 node scripts/skill-e2e.mjs",
    "test:agent-skills": "node --import tsx scripts/agent-skill-smoke.ts",
    "test:codex-prompts": "node --import tsx scripts/codex-prompt-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.4",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "open": "^10.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.19.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.18.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.4.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "png2icons": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "semver": "^7.7.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "zustand": "^5.0.3"
  }
}
