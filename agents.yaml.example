# ithyno agent registry.
#
# Copy this file to `agents.yaml` at the project root and edit. The dashboard
# loads it on startup and again whenever the file changes. With no agents
# defined (or no `agents.yaml`), the Kanban Run button is hidden.
#
# Template variables available in `args`, `env`, and `initialInput`:
#   ${change_id}     — the OpenSpec change id (e.g. "add-task-filter")
#   ${worktree_path} — absolute path to the agent's git worktree
#   ${branch}        — the agent branch ("agent/<change-id>")
#
# Spawning is `child_process.spawn(command, args, { cwd: worktree_path, env,
# stdio: ["ignore", "pipe", "pipe"] })`. Agents run headless (no TTY); Claude
# Code and friends should be invoked in their non-interactive `-p` mode so
# they print plain lines to stdout and exit cleanly.
#
# `initialInput` (optional) — when set, the runner prepends `-p
# "<initialInput>"` to `args` at spawn time (unless `args` already contains
# `-p`, in which case the user's explicit configuration wins). This is the
# recommended way to hand the CLI its opening task without hard-coding the
# `-p` flag in `args`.
#
# Worktree isolation limits the blast radius of `-p` mode's implicit
# permission grant — every write lands under `.worktrees/<change-id>/`.

agents:
  # Default Claude entry — uses `/ithy-opsx:apply` so the agent branch ends
  # with the implementation committed. The wrapping skill delegates to
  # `/opsx:apply` for the actual work, then adds one `git commit` at the
  # end. See `.claude/skills/ithy-opsx-apply/SKILL.md`.
  #
  # Prefer this over the bare `/opsx:apply` unless you have a reason (e.g.
  # you drive commits some other way, or you want the archive skill's
  # safety-net commit step to be the single point of commit).
  - name: claude
    description: Implements the change using Claude Code via /ithy-opsx:apply (adds a commit at end).
    command: claude
    args: []
    initialInput: "/ithy-opsx:apply ${change_id}"

  # Add more agents as you need them — any local CLI works.
  # - name: aider
  #   description: Implements with Aider.
  #   command: aider
  #   args: ["--yes-always"]
  #   initialInput: "Implement OpenSpec change ${change_id}"
  #   env:
  #     OPENAI_API_KEY: "..."
  #
  # Bare non-committing Claude — the archive skill's safety net catches
  # the commit at merge time. Use this if you want the "single commit at
  # archive" flow rather than "commit at implement + commit at archive."
  # - name: claude-plain
  #   command: claude
  #   args: []
  #   initialInput: "/opsx:apply ${change_id}"
  #
  # An alternative shape for Claude that uses print mode instead of stdin.
  # Works today but is more coupled to the Claude CLI's flag surface.
  # - name: claude-print
  #   command: claude
  #   args: ["--dangerously-skip-permissions", "-p", "/ithy-opsx:apply ${change_id}"]
