# ithyno agent registry.
#
# Copy this file to `agents.yaml` at the project root and edit. The
# dashboard loads it on startup and again whenever the file changes.
# With no agents defined (or no `agents.yaml`), the Kanban Run button is
# hidden.
#
# ─── Schema (post reshape-agents-yaml-mode-roles) ──────────────────────────
#
# Every agent entry has:
#   name           kebab-case identifier
#   mode           "single-prompt" or "live-shell". See below for the
#                  worker vs manager semantics.
#   roles          non-empty list of dispatch labels: code, review, verify,
#                  manager, other (or your own custom role names)
#   command        (or reference `runtime:` for shared defaults)
#   args           command-line arguments
#   prompts        optional per-role prompt override
#                  (falls back to runtime.prompts → built-in defaults)
#   specialties    tag prefixes used for dispatch routing (empty = any)
#   concurrency    max parallel jobs (default 1)
#   dedicated      per-change worktree vs pool (default true)
#
# Built-in per-role prompt defaults (used when neither `agent.prompts.<role>`
# nor `runtime.prompts.<role>` is set):
#   code    → /opsx:apply ${change_id}
#   review  → /opsx:review ${change_id}
#   verify  → /opsx:verify ${change_id}
#   manager → /opsx:manage
#
# Template variables available inside prompts, args, and env:
#   ${change_id}     — the OpenSpec change id
#   ${worktree_path} — absolute path to the agent's git worktree
#   ${branch}        — the agent branch ("agent/<change-id>")
#   ${session_id}    — change-scoped session id for conversation grouping
#                      (persisted at .ithyno/sessions.json; stable across
#                      server restarts; empty string when unavailable).
#                      Value is an RFC 4122 UUID v4 (Claude Code's
#                      `--session-id <uuid>` requires this format).
#                      Example: args: [--session-id, "${session_id}"]
#
# ─── `mode` semantics ──────────────────────────────────────────────────────
#
# `single-prompt` (workers): headless spawn. The resolved prompt is
#   appended to args as `[promptFlag, prompt]` (default `-p`), unless
#   args already inline the flag. Best fit for CLIs like Claude Code
#   whose "print mode" (`-p`) is the non-interactive entry point.
#
# `live-shell` (workers): headless spawn with **stdin piped**. The
#   resolved prompt is written to `child.stdin\n` and stdin is closed.
#   No PTY. Best fit for CLIs that read prompt input from stdin
#   (aider `--message-stdin`, gh copilot suggest -stdin, custom
#   scripts). NOT suitable for CLIs that require a TTY — Claude Code
#   without `-p` needs a real terminal, so use `single-prompt` for it.
#   For interactive-TTY workers (e.g. Claude Code with the full
#   interactive UI so it can /agmsg peers), wrap the command via a
#   tmux-spawning helper such as agmsg
#   (https://github.com/fujibee/agmsg) — set `command:` to the wrapper
#   and let it allocate the PTY inside tmux. The ithyno runner itself
#   never opens a PTY for workers.
#
# `live-shell` (manager): spawned by the Terminal panel WebSocket,
#   which allocates a real PTY. Manager is a singleton; declared here
#   with `roles: [manager]`.
#
# ─── Backward compatibility ────────────────────────────────────────────────
#
# Old shapes still load with a warning:
#   role: <name>              → normalized to roles: [<name>]
#   initialInput: <string>    → folded into prompts.<sole-role>
#   runtime + prompt          → normalized to prompts.<sole-role>
# Legacy `role: coder` is mapped to `code`.

# ─── Optional shared-defaults registry ─────────────────────────────────────
# Runtimes let multiple agents inherit the same command / args / prompt
# defaults. An agent that specifies `runtime: <name>` picks up all of
# these unless it overrides them locally.
#
# runtimes:
#   claude:
#     command: claude
#     baseArgs: [--dangerously-skip-permissions]
#     promptStyle: cli-arg              # cli-arg | stdin | file (file: reserved)
#     promptFlag: -p                    # inlined before the resolved prompt
#     prompts:
#       code: "/opsx:apply ${change_id}"
#       review: "/opsx:review ${change_id}"
#       verify: "/opsx:verify ${change_id}"
#       manager: "/opsx:manage"
#     supports:
#       interactive: true
#       artifactOutput: true
#       diff: git

agents:
  # ---------- Manager (mode: live-shell) ------------------------------------
  # The interactive REPL that runs in the embedded Terminal panel. Manager
  # agents MUST have `mode: live-shell`. At most one Manager may be declared.
  #
  # If no Manager is declared, the Terminal panel falls back to
  # `ITHYNO_TERMINAL_STARTUP` env var and then to `claude --continue`.
  #
  # - name: primary-manager
  #   mode: live-shell
  #   roles: [manager]
  #   command: claude
  #   args: ["--continue"]
  #   prompts:
  #     manager: "/opsx:manage"

  # ---------- Workers (mode: single-prompt) ---------------------------------
  # Default Claude entry — uses `/ithy-opsx:apply` so the agent branch
  # ends with the implementation committed. The wrapping skill delegates
  # to `/opsx:apply` for the actual work, then adds one `git commit` at
  # the end. See `.claude/skills/ithy-opsx-apply/SKILL.md`.
  - name: claude
    description: Implements the change using Claude Code via /ithy-opsx:apply (adds a commit at end).
    mode: single-prompt
    roles: [code]
    command: claude
    args: ["--dangerously-skip-permissions", "-p", "/ithy-opsx:apply ${change_id}"]

  # Multi-role example: one CLI covers code + review + verify. Dispatched
  # role determines which built-in prompt fires (or override via prompts).
  #
  # - name: claude-all-in-one
  #   mode: single-prompt
  #   roles: [code, review, verify]
  #   command: claude
  #   args: ["--dangerously-skip-permissions"]
  #   # No explicit prompts → per-role built-in defaults fire.

  # Runtime-referenced example: shares defaults from the `runtimes:` block.
  #
  # - name: claude-reviewer
  #   mode: single-prompt
  #   roles: [review]
  #   runtime: claude
  #   # Inherits command, baseArgs, promptStyle, promptFlag, and prompts
  #   # from `runtimes.claude`. Override any locally if needed.

  # Aider example — different CLI, different prompt style.
  # - name: aider
  #   mode: single-prompt
  #   roles: [code]
  #   command: aider
  #   args: ["--yes-always"]
  #   prompts:
  #     code: "Implement OpenSpec change ${change_id}"
  #   env:
  #     OPENAI_API_KEY: "..."
